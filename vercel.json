{
  "buildCommand": "node scripts/generate-app-icon-prefetch.mjs && node scripts/generate-pwa-splash-icons.mjs && vite build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "organismplanner.com" }],
      "destination": "https://timeisprice.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.organismplanner.com" }],
      "destination": "https://timeisprice.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/auth/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
