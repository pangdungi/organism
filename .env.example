# (선택) 관리자전용 메뉴 — 비우면 앱에 지정된 기본 관리자 이메일과만 비교. 다른 이메일로 쓰려면 여기에 적기.
# 서버(RPC) 권한은 supabase/migrations/20260426120000_app_admin_subscriptions_rpcs.sql 의 lp_app_admin_email 과 맞춰야 함(배포 후 SQL Editor에서 함수 수정 가능).
VITE_APP_ADMIN_EMAIL=

# 슈퍼 계정 (이 아이디/비번으로 로그인 가능)
VITE_SUPER_ID=your_super_email@example.com
VITE_SUPER_PW=your_super_password

# Supabase (https://supabase.com 가입 후 프로젝트 생성)
# 프로젝트 설정 → API에서 URL과 anon key 복사
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# (권장·운영) 이메일 인증이 돌아올 "사이트 루트" 도메인(프로토콜+호스트만). 비우면 지금 접속 origin 사용.
# 예: VITE_AUTH_EMAIL_REDIRECT_URL=https://timeisprice.com
#  → 가입 확인: https://timeisprice.com/  /  비번 재설정: https://timeisprice.com/auth/recovery
# Supabase → Authentication → URL 의 Redirect URLs 에 위 URL들(및 www 있으면 둘 다)을 등록하세요.
# 프리뷰 *.vercel.app 만 쓰면 배포 삭제 후 메일 링크 404가 날 수 있음.
# VITE_AUTH_EMAIL_REDIRECT_URL=https://www.example.com

# (서버·Edge Function) 시간 레포트 AI — 클라이언트에 넣지 마세요.
# Supabase 대시보드 → Edge Functions → Secrets 또는 CLI:
#   supabase secrets set OPENAI_API_KEY=sk-...
#   supabase secrets set OPENAI_MODEL=gpt-4o-mini
#   supabase functions deploy time-report-analyze
#
# (서버·Edge Function) 아임웹 OAuth 연동 — 클라이언트 .env 에 넣지 마세요.
# Supabase → Edge Functions → Secrets:
#   IMWEB_CLIENT_ID=...
#   IMWEB_CLIENT_SECRET=...
#   IMWEB_REDIRECT_URI=https://<project>.supabase.co/functions/v1/imweb-oauth-callback?apikey=<anon_key>
#   IMWEB_OAUTH_SCOPE=order:read site-info:read
#   IMWEB_CONNECT_SUCCESS_URL=https://timeisprice.com/
# 개발자센터 리다이렉트 URI 도 IMWEB_REDIRECT_URI 와 동일하게 등록하세요.
